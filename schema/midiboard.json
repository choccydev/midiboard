{
    "$schema": "https://raw.githubusercontent.com/choccydev/midiboard/master/schema/midiboard.schema.json",
    "config_version": 2,
    "log_level": "warn",
    "devices": [
        {
            "name": "Your Device Here",
            "controls": {
                "volume": {
                    "key": 7,
                    "type": "cc",
                    "command": {
                        "kind": "Encoder",
                        "mode": "absolute",
                        "map_min": 0,
                        "map_max": 100,
                        "execute": {
                            "cmd": "pactl",
                            "args": ["set-sink-volume", "@DEFAULT_SINK@", "{value}%"]
                        }
                    }
                },
                "play_pause": {
                    "key": 45,
                    "type": "note",
                    "command": {
                        "kind": "Trigger",
                        "execute": {
                            "cmd": "playerctl",
                            "args": ["play-pause"]
                        }
                    }
                }
            }
        }
    ]
}
